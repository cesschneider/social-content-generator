# ─── AI / GENERATION ──────────────────────────────────────────────────────────

# Anthropic — Claude API (text generation for all platforms)
# Optional when running inside a Claude Code session — credentials are inherited automatically.
ANTHROPIC_API_KEY=

# HuggingFace — FLUX image generation
HUGGINGFACE_API_KEY=

# HeyGen — AI avatar video generation
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# Higgsfield — cinematic B-roll video generation
HIGGSFIELD_API_KEY=

# ElevenLabs — voiceover / text-to-speech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ─── CONTENT CALENDAR ─────────────────────────────────────────────────────────

# Notion — content calendar database
NOTION_API_KEY=
NOTION_CALENDAR_DATABASE_ID=

# ─── MEDIA HOSTING ────────────────────────────────────────────────────────────

# Cloudinary — asset hosting (required for all social API uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── PUBLISHING — YOUTUBE ─────────────────────────────────────────────────────

# YouTube Data API v3 (OAuth 2.0 — run pipeline.auth.setup --platform youtube)
YOUTUBE_CLIENT_SECRET_FILE=credentials/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=credentials/youtube_token.json

# ─── PUBLISHING — LINKEDIN ────────────────────────────────────────────────────

# LinkedIn Marketing API (OAuth 2.0 — run pipeline.auth.setup --platform linkedin)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# ─── PUBLISHING — INSTAGRAM ───────────────────────────────────────────────────

# Instagram Graph API (via Meta for Developers — requires Business Account)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ─── PUBLISHING — TIKTOK ──────────────────────────────────────────────────────

# TikTok Content Posting API (OAuth 2.0 PKCE — run pipeline.auth.setup --platform tiktok)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# ─── PUBLISHING — X (TWITTER) ─────────────────────────────────────────────────

# X API v2 (OAuth 1.0a — generate via developer.twitter.com)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# ─── PUBLISHING — SUBSTACK / GHOST ────────────────────────────────────────────

# Substack (API key from publication settings — if using Substack directly)
SUBSTACK_API_KEY=
SUBSTACK_PUBLICATION_URL=

# Ghost (Admin API — if using Ghost as an alternative newsletter backend)
GHOST_ADMIN_API_KEY=
GHOST_API_URL=

# ─── TRACKING / OBSERVABILITY ─────────────────────────────────────────────────

# Supabase — logs published URLs to content_log table
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
